/**
 * Writes src/lib/episodeTitles.ts: the short title of every episode, taken from its title-card
 * `onScreen` ("EP 43 · SEARCHING"). The Outro uses it for "Next episode", so it shows a title for
 * every Bible wording of the outro line ("Next: EP 43 Searching", "Next: EP 27, the for loop", ...).
 * Usage: node scripts/gen_episode_titles.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const ROOT = new URL("..", import.meta.url).pathname.replace(/^\/([a-zA-Z]:)/, "$1");
const lines: string[] = [];
for (let n = 1; n <= 86; n++) {
  const file = join(ROOT, "episodes", `ep${String(n).padStart(3, "0")}.json`);
  const data = JSON.parse(readFileSync(file, "utf-8")) as { scenes: { template: string; onScreen: string }[] };
  const card = data.scenes.find((s) => s.template === "title-card");
  const m = /^EP\s*(\d+)\s*[·-]\s*(.+)$/.exec(card?.onScreen ?? "");
  if (!m || Number(m[1]) !== n) throw new Error(`ep${n}: title card is not "EP ${n} · TITLE": ${card?.onScreen}`);
  lines.push(`  ${n}: ${JSON.stringify(m[2].trim())},`);
}
const out = `/** Generated by scripts/gen_episode_titles.mts from each episode's title card. Do not edit. */
export const EPISODE_TITLES: Readonly<Record<number, string>> = {
${lines.join("\n")}
};
`;
writeFileSync(join(ROOT, "src", "lib", "episodeTitles.ts"), out, "utf-8");
console.log(`wrote ${lines.length} titles`);
